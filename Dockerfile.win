FROM dockcross/windows-static-x64:latest

ARG QT_VERSION=6.10.2
ARG VCPKG_VERSION=2024.11.16

RUN apt-get update && apt-get install -y \
    python3 \
    git \
    wget \
    curl \
    unzip \
    tar \
    ninja-build \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Install Qt6 for Windows (MinGW) using aqtinstall
RUN pip3 install --break-system-packages aqtinstall || true

RUN for i in 1 2 3; do \
    aqt install-qt windows desktop ${QT_VERSION} win64_mingw \
    --outputdir /opt/qt \
    --modules qtimageformats qtnetworkauth && break || sleep 10; \
    done || true

ENV PATH=/opt/qt/${QT_VERSION}/mingw_64/bin:$PATH
ENV CMAKE_PREFIX_PATH=/opt/qt/${QT_VERSION}/mingw_64
ENV QT_PLUGIN_PATH=/opt/qt/${QT_VERSION}/mingw_64/plugins
ENV CC=x86_64-w64-mingw32-gcc
ENV CXX=x86_64-w64-mingw32-g++

# Install vcpkg for dependency management
RUN git clone https://github.com/microsoft/vcpkg.git /opt/vcpkg && \
    cd /opt/vcpkg && \
    git checkout ${VCPKG_VERSION} && \
    ./bootstrap-vcpkg.sh

ENV VCPKG_ROOT=/opt/vcpkg
ENV PATH=/opt/vcpkg:$PATH

# Install dependencies using vcpkg for MinGW
RUN /opt/vcpkg/vcpkg install cmark \
    libqrencode \
    tomlplusplus \
    libarchive \
    --triplet=x64-mingw-static \
    --host-triplet=x64-mingw-static || true

WORKDIR /work
